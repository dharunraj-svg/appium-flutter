# Copy this file to .env and fill in the values. .env is git-ignored.

# Target app for direct runs (npm run test:* and CI). One of:
#   kiosk, kiosk-android, kennel, kennel-android, groomers, groomers-android.
# `npm run test:local` sets this for you, so you can leave it as is.
TARGET_APP=kiosk

# Debug simulator build of the kiosk app (flutter build ios --simulator --debug).
KIOSK_APP_PATH=/Users/runloyal/RunLoyal/Flutter/kiosk-turbo/staff-turbo-flutter/apps/kiosk/build/ios/iphonesimulator/Runner.app

# Debug APK of the kiosk app for TARGET_APP=kiosk-android
# (flutter build apk --debug), or wherever a downloaded prebuilt APK lands.
KIOSK_APK_PATH=

# Kennel and groomers debug builds (iOS simulator .app and Android .apk).
# `npm run test:local` finds these in the Flutter checkout, or builds them if missing.
KENNEL_APP_PATH=
KENNEL_APK_PATH=
GROOMERS_APP_PATH=
GROOMERS_APK_PATH=

# Appium server (started with `appium`, default port 4723).
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# iOS simulator. Name and UDID come from `xcrun simctl list devices`.
IOS_DEVICE_NAME=iPad mini (A17 Pro)
IOS_UDID=94970434-01EC-4BD1-8BE4-18D2E22F3EEC

# Android emulator (only used for TARGET_APP=kiosk-android). The udid is the
# adb serial — `emulator-5554` is the default for the first/only emulator,
# which is what both a local `emulator -avd ...` and
# reactivecircus/android-emulator-runner in CI produce.
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_UDID=emulator-5554

# Kiosk staff account used to sign in to the kiosk. Never commit real values.
KIOSK_TEST_EMAIL=
KIOSK_TEST_PASSWORD=

# Employee account used for the clock-in test (email plus password or PIN).
KIOSK_EMPLOYEE_EMAIL=
KIOSK_EMPLOYEE_PASSWORD_OR_PIN=

# Simulator location for the clock-in test. Must be inside the test location's geofence.
KIOSK_SIM_LATITUDE=11.395139
KIOSK_SIM_LONGITUDE=79.092415
